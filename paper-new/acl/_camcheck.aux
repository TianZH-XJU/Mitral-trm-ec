\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Confidence halting retains exact-match accuracy at a fraction of the executed compute.} Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). NI denotes non-inferiority, decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp, \emph  {not} by point estimates; CMA-ES denotes sep-CMA-ES. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 7 of 9 satisfy the point-estimate margin.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:halting}{{1}{5}{\textbf {Confidence halting retains exact-match accuracy at a fraction of the executed compute.} Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). NI denotes non-inferiority, decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp, \emph {not} by point estimates; CMA-ES denotes sep-CMA-ES. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 7 of 9 satisfy the point-estimate margin}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Causal Execution and Implementation Validation}{5}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Adaptive Halting Results (RQ1)}{5}{subsection.4.3}\protected@file@percent }
\newlabel{sec:exp-halting}{{4.3}{5}{Adaptive Halting Results (RQ1)}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The threshold already sits on the accuracy--compute frontier.} For each seed we contrast the preregistered threshold with the cheapest policy the equal-budget optimizers found. The searched policies buy at most 2.1\% more saving than the threshold and, on seeds 0--1, do not pass the non-inferiority bound that the threshold passes. NI denotes the preregistered rule LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp; extra saving is the compute the searched policy removes beyond the threshold, relative to the threshold's own saving. Full policy list in Table~\ref {tab:halting}.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:frontier}{{2}{6}{\textbf {The threshold already sits on the accuracy--compute frontier.} For each seed we contrast the preregistered threshold with the cheapest policy the equal-budget optimizers found. The searched policies buy at most 2.1\% more saving than the threshold and, on seeds 0--1, do not pass the non-inferiority bound that the threshold passes. NI denotes the preregistered rule LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp; extra saving is the compute the searched policy removes beyond the threshold, relative to the threshold's own saving. Full policy list in Table~\ref {tab:halting}}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Step-size policies improve fixed-depth exact match at constant compute.} Fixed-depth (constant $N_{\mathrm  {cell}}$) improvements over the original $\alpha {\approx }1$ update on the inner subset ($n{=}192$); all searches use exactly 336 evaluations, and CMA denotes sep-CMA-ES. A hand-designed linearly decaying schedule ($\alpha _k = 1.0-0.5k/K$, i.e., $[1.0, 0.833, 0.667]$ at depth 3) and fixed $\alpha \in \{0.75, 0.5, 0.25\}$ never exceed the $\alpha {\approx }1$ baseline. Ablations on $s_0$ restrict the policy input to a single feature group; the full-feature GA result corresponds to the GA column.}}{6}{table.caption.9}\protected@file@percent }
\newlabel{tab:latent}{{3}{6}{\textbf {Step-size policies improve fixed-depth exact match at constant compute.} Fixed-depth (constant $N_{\mathrm {cell}}$) improvements over the original $\alpha {\approx }1$ update on the inner subset ($n{=}192$); all searches use exactly 336 evaluations, and CMA denotes sep-CMA-ES. A hand-designed linearly decaying schedule ($\alpha _k = 1.0-0.5k/K$, i.e., $[1.0, 0.833, 0.667]$ at depth 3) and fixed $\alpha \in \{0.75, 0.5, 0.25\}$ never exceed the $\alpha {\approx }1$ baseline. Ablations on $s_0$ restrict the policy input to a single feature group; the full-feature GA result corresponds to the GA column}{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Fixed-Depth Evolutionary Latent Control (RQ2)}{6}{subsection.4.4}\protected@file@percent }
\newlabel{sec:exp-latent}{{4.4}{6}{Fixed-Depth Evolutionary Latent Control (RQ2)}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Equal-budget evolutionary search improves the latent update at fixed depth.} Inner-subset EM gain (pp) over the original $\alpha {\approx }1$ update for random search and three evolutionary optimizers at equal budgets of 336 evaluations. Feature-group ablations on $s_0$ show that the time index alone and the dynamics pair alone each reproduce the full-feature gain, while entropy alone does not.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:latent}{{2}{6}{\textbf {Equal-budget evolutionary search improves the latent update at fixed depth.} Inner-subset EM gain (pp) over the original $\alpha {\approx }1$ update for random search and three evolutionary optimizers at equal budgets of 336 evaluations. Feature-group ablations on $s_0$ show that the time index alone and the dynamics pair alone each reproduce the full-feature gain, while entropy alone does not}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Refinement steps change the latent state less as depth grows.} Per-step displacement and direction consistency of the latent trajectory under fixed damping on the frozen GRU decoder. The concentration of small displacements at later steps motivates a step-size policy that reads entropy, displacement, and direction consistency at decision time.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:traj}{{3}{7}{\textbf {Refinement steps change the latent state less as depth grows.} Per-step displacement and direction consistency of the latent trajectory under fixed damping on the frozen GRU decoder. The concentration of small displacements at later steps motivates a step-size policy that reads entropy, displacement, and direction consistency at decision time}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {One-shot confirmation separates retained gains from inner-subset gains.} Held-out fold ($n{=}645$ per seed); NI denotes non-inferiority; CIs are 95\% group-cluster bootstrap intervals of $\Delta $EM (pp) vs.\ the frozen-depth baseline (20{,}000 resamples). J1 passes non-inferiority on all seeds, on $s_2$ only marginally, with 95\% CI $[-0.50, +7.43]$pp, i.e., an LCB of $-0.4975$pp, only 0.0025pp above the bound. The best joint EC policy (selected by inner fitness) fails on $s_1$ and $s_2$, losing on $s_2$ the entire EM gain of the threshold policy (paired $\Delta $EM $-2.02$pp vs.\ J1).}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:confirm}{{4}{7}{\textbf {One-shot confirmation separates retained gains from inner-subset gains.} Held-out fold ($n{=}645$ per seed); NI denotes non-inferiority; CIs are 95\% group-cluster bootstrap intervals of $\Delta $EM (pp) vs.\ the frozen-depth baseline (20{,}000 resamples). J1 passes non-inferiority on all seeds, on $s_2$ only marginally, with 95\% CI $[-0.50, +7.43]$pp, i.e., an LCB of $-0.4975$pp, only 0.0025pp above the bound. The best joint EC policy (selected by inner fitness) fails on $s_1$ and $s_2$, losing on $s_2$ the entire EM gain of the threshold policy (paired $\Delta $EM $-2.02$pp vs.\ J1)}{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Joint Control and One-Shot Evaluation (RQ3)}{7}{subsection.4.5}\protected@file@percent }
\newlabel{sec:exp-joint}{{4.5}{7}{Joint Control and One-Shot Evaluation (RQ3)}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Where the joint policy loses.} Held-out fold ($n{=}645$ per seed); J1 is the threshold policy and J4 the jointly tuned policy, with $\Delta $EM in percentage points against each seed's frozen best fixed depth (Table~\ref {tab:confirm}). The last two columns split the J4--J1 gap into the share carried by the searched halting gates and the share carried by the searched step sizes, measured by re-decoding J4 with $\alpha {=}1$; flips count the sequences whose EM changes between J1 and J4, as repair/harm.}}{7}{table.caption.13}\protected@file@percent }
\newlabel{tab:decomp}{{5}{7}{\textbf {Where the joint policy loses.} Held-out fold ($n{=}645$ per seed); J1 is the threshold policy and J4 the jointly tuned policy, with $\Delta $EM in percentage points against each seed's frozen best fixed depth (Table~\ref {tab:confirm}). The last two columns split the J4--J1 gap into the share carried by the searched halting gates and the share carried by the searched step sizes, measured by re-decoding J4 with $\alpha {=}1$; flips count the sequences whose EM changes between J1 and J4, as repair/harm}{table.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Fresh-Split Confirmation and Robustness Checks}{7}{subsection.4.6}\protected@file@percent }
\newlabel{sec:exp-fresh}{{4.6}{7}{Fresh-Split Confirmation and Robustness Checks}{subsection.4.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {One-shot confirmation on untouched data.} Official COGS development set ($n{=}3{,}000$; group-cluster paired bootstrap, 20{,}000 resamples), evaluated once with the frozen preregistered threshold and each seed's frozen best fixed depth. The compute ratios match the held-out-fold values (0.2575 / 0.2570 / 0.5212) to the third decimal, so the executed-call savings themselves transfer across splits.}}{8}{table.caption.14}\protected@file@percent }
\newlabel{tab:devconfirm}{{6}{8}{\textbf {One-shot confirmation on untouched data.} Official COGS development set ($n{=}3{,}000$; group-cluster paired bootstrap, 20{,}000 resamples), evaluated once with the frozen preregistered threshold and each seed's frozen best fixed depth. The compute ratios match the held-out-fold values (0.2575 / 0.2570 / 0.5212) to the third decimal, so the executed-call savings themselves transfer across splits}{table.caption.14}{}}
