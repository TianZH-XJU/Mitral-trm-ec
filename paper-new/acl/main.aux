\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Recursive encoder--decoder architecture reproduced from the implemented model. The encoder produces a source memory and an initial decoder state. A base \textsc  {GRUCell} emits $z^{(0)}$ from the previous token embedding and the attention context. A single refinement \textsc  {GRUCell}, shared across all depths, reads the previous token embedding, the same context, and a soft embedding of the current prediction. One output head is shared across depths.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{3}{Recursive encoder--decoder architecture reproduced from the implemented model. The encoder produces a source memory and an initial decoder state. A base \textsc {GRUCell} emits $z^{(0)}$ from the previous token embedding and the attention context. A single refinement \textsc {GRUCell}, shared across all depths, reads the previous token embedding, the same context, and a soft embedding of the current prediction. One output head is shared across depths}{figure.caption.1}{}}
