\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Step-size policies improve fixed-depth exact match at constant compute.} Fixed-depth (constant $N_{\mathrm  {cell}}$) improvements over the original $\alpha {\approx }1$ update on the inner subset ($n{=}192$); all searches use exactly 336 evaluations, and CMA denotes sep-CMA-ES. A hand-designed linearly decaying schedule ($\alpha _k = 1.0-0.5k/K$, i.e., $[1.0, 0.833, 0.667]$ at depth 3) and fixed $\alpha \in \{0.75, 0.5, 0.25\}$ never exceed the $\alpha {\approx }1$ baseline. Ablations on $s_0$ restrict the policy input to a single feature group; the full-feature GA result corresponds to the GA column.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:latent}{{7}{7}{\textbf {Step-size policies improve fixed-depth exact match at constant compute.} Fixed-depth (constant $N_{\mathrm {cell}}$) improvements over the original $\alpha {\approx }1$ update on the inner subset ($n{=}192$); all searches use exactly 336 evaluations, and CMA denotes sep-CMA-ES. A hand-designed linearly decaying schedule ($\alpha _k = 1.0-0.5k/K$, i.e., $[1.0, 0.833, 0.667]$ at depth 3) and fixed $\alpha \in \{0.75, 0.5, 0.25\}$ never exceed the $\alpha {\approx }1$ baseline. Ablations on $s_0$ restrict the policy input to a single feature group; the full-feature GA result corresponds to the GA column}{table.caption.11}{}}
