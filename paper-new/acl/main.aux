\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {TRACER overview: trace, halt, and control recursive computation.} \textbf  {(a)} At token $i$, a frozen recursive GRU produces depths $e_0,e_1,e_3$ (gray). Two causal confidence gates (blue) read prefix signals $x_i^{(0)},x_i^{(1)}$ that are available before the refinement they control, so a stopped token never enters the skipped call. Runtime interception (green) counts the actual base and refinement calls, yielding $N_{\mathrm  {cell}}$ rather than an inferred exit depth. \textbf  {(b)} At fixed depth, a five-parameter policy maps prediction entropy, update magnitude, update direction, and depth to a step size $\alpha _i^{(k)}\in (0,1)$ that rescales the refinement displacement without changing $N_{\mathrm  {cell}}$. The policy is frozen before outer confirmation and transferred without re-search; transfer is partial (four of nine target seeds non-inferior), which marks the boundary of the learned rule.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:framework}{{5}{6}{\textbf {TRACER overview: trace, halt, and control recursive computation.} \textbf {(a)} At token $i$, a frozen recursive GRU produces depths $e_0,e_1,e_3$ (gray). Two causal confidence gates (blue) read prefix signals $x_i^{(0)},x_i^{(1)}$ that are available before the refinement they control, so a stopped token never enters the skipped call. Runtime interception (green) counts the actual base and refinement calls, yielding $N_{\mathrm {cell}}$ rather than an inferred exit depth. \textbf {(b)} At fixed depth, a five-parameter policy maps prediction entropy, update magnitude, update direction, and depth to a step size $\alpha _i^{(k)}\in (0,1)$ that rescales the refinement displacement without changing $N_{\mathrm {cell}}$. The policy is frozen before outer confirmation and transferred without re-search; transfer is partial (four of nine target seeds non-inferior), which marks the boundary of the learned rule}{figure.caption.5}{}}
