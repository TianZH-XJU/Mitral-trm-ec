\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Causal halting skips redundant refinements while auditing executed calls.} \textbf  {(a)} At token $i$, frozen recursive GRU steps ($e_0, e_1, e_3$, gray) are gated by causal confidence thresholds (blue, Ours) using prefix signals ($x_i^{(0)}, x_i^{(1)}$) before unexecuted refinements run, while runtime interception counts true calls ($N_{\mathrm  {cell}}$) from input to output (green). \textbf  {(b)} At fixed depth, evolutionary step-size policies modulate $\Delta z_i^{(k)}$ via $\alpha _i^{(k)}$, whereas jointly tuned gates and step sizes (orange) do not transfer to held-out data (\S  \ref {sec:exp-joint}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:method_overview}{{1}{2}{\textbf {Causal halting skips redundant refinements while auditing executed calls.} \textbf {(a)} At token $i$, frozen recursive GRU steps ($e_0, e_1, e_3$, gray) are gated by causal confidence thresholds (blue, Ours) using prefix signals ($x_i^{(0)}, x_i^{(1)}$) before unexecuted refinements run, while runtime interception counts true calls ($N_{\mathrm {cell}}$) from input to output (green). \textbf {(b)} At fixed depth, evolutionary step-size policies modulate $\Delta z_i^{(k)}$ via $\alpha _i^{(k)}$, whereas jointly tuned gates and step sizes (orange) do not transfer to held-out data (\S \ref {sec:exp-joint})}{figure.caption.1}{}}
