\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces \textbf  {Where the joint policy loses.} Held-out fold ($n{=}645$ per seed); J1 is the threshold policy and J4 the jointly tuned policy, with $\Delta $EM in percentage points against each seed's frozen best fixed depth (Table~\ref {tab:confirm}). The last two columns split the J4--J1 gap into the share carried by the searched halting gates and the share carried by the searched step sizes, measured by re-decoding J4 with $\alpha {=}1$; flips count the sequences whose EM changes between J1 and J4, as repair/harm.}}{10}{table.caption.19}\protected@file@percent }
\newlabel{tab:decomp}{{12}{10}{\textbf {Where the joint policy loses.} Held-out fold ($n{=}645$ per seed); J1 is the threshold policy and J4 the jointly tuned policy, with $\Delta $EM in percentage points against each seed's frozen best fixed depth (Table~\ref {tab:confirm}). The last two columns split the J4--J1 gap into the share carried by the searched halting gates and the share carried by the searched step sizes, measured by re-decoding J4 with $\alpha {=}1$; flips count the sequences whose EM changes between J1 and J4, as repair/harm}{table.caption.19}{}}
