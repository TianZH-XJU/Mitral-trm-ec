\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Confidence halting retains exact-match accuracy at a fraction of the executed compute.} Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). NI denotes non-inferiority, decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp, \emph  {not} by point estimates; CMA-ES denotes sep-CMA-ES. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 8 of 9 satisfy the point-estimate margin.}}{5}{table.caption.5}\protected@file@percent }
\newlabel{tab:halting}{{3}{5}{\textbf {Confidence halting retains exact-match accuracy at a fraction of the executed compute.} Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). NI denotes non-inferiority, decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp, \emph {not} by point estimates; CMA-ES denotes sep-CMA-ES. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 8 of 9 satisfy the point-estimate margin}{table.caption.5}{}}
