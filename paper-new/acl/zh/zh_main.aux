\newlabel{sec:exp-halting}{{4.3}{7}{自适应停算结果（RQ1）}{subsection.4.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {置信停算以一小部分执行计算量保持住精确匹配准确率。} 留出折（每种子 $n{=}645$），相对各种子冻结的最佳固定深度（种子 0--1 为 $e_3$，种子 2 为 $e_1$）。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp 判定，\emph  {而非}点估计；CMA-ES 指 sep-CMA-ES。阈值策略在三个种子上都非劣效；9 个进化式策略中只有 2 个通过，尽管 7 个满足点估计容差。}}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:halting}{{1}{7}{\textbf {置信停算以一小部分执行计算量保持住精确匹配准确率。} 留出折（每种子 $n{=}645$），相对各种子冻结的最佳固定深度（种子 0--1 为 $e_3$，种子 2 为 $e_1$）。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp 判定，\emph {而非}点估计；CMA-ES 指 sep-CMA-ES。阈值策略在三个种子上都非劣效；9 个进化式策略中只有 2 个通过，尽管 7 个满足点估计容差。}{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {阈值本身已经位于准确率--计算量前沿上。} 每个种子都把预注册阈值与等预算优化器找到的最省策略相对照。被搜索到的策略比阈值最多再多省 2.1\%，而且在种子 0--1 上它们通不过阈值通得过的非劣效界。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp 判定；额外节省指被搜索到的策略相对阈值自身节省额多去掉的那部分计算量。完整策略列表见表~\ref {tab:halting}。}}{8}{table.caption.8}\protected@file@percent }
\newlabel{tab:frontier}{{2}{8}{\textbf {阈值本身已经位于准确率--计算量前沿上。} 每个种子都把预注册阈值与等预算优化器找到的最省策略相对照。被搜索到的策略比阈值最多再多省 2.1\%，而且在种子 0--1 上它们通不过阈值通得过的非劣效界。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp 判定；额外节省指被搜索到的策略相对阈值自身节省额多去掉的那部分计算量。完整策略列表见表~\ref {tab:halting}。}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}固定深度演化式隐状态控制（RQ2）}{9}{subsection.4.4}\protected@file@percent }
\newlabel{sec:exp-latent}{{4.4}{9}{固定深度演化式隐状态控制（RQ2）}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {步长策略在计算量恒定时提高固定深度的精确匹配准确率。} 相对原始 $\alpha {\approx }1$ 更新、在内层子集（$n{=}192$）上的固定深度（$N_{\mathrm  {cell}}$ 恒定）改进；所有搜索恰用 336 次评估，CMA 指 sep-CMA-ES。人工设计的线性递减 schedule（$\alpha _k = 1.0-0.5k/K$，深度 3 时即 $[1.0, 0.833, 0.667]$）与固定 $\alpha \in \{0.75, 0.5, 0.25\}$ 都不超过 $\alpha {\approx }1$ 基线。$s_0$ 上的消融把策略输入限制到单一特征组；全特征 GA 结果对应 GA 列。}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:latent}{{3}{9}{\textbf {步长策略在计算量恒定时提高固定深度的精确匹配准确率。} 相对原始 $\alpha {\approx }1$ 更新、在内层子集（$n{=}192$）上的固定深度（$N_{\mathrm {cell}}$ 恒定）改进；所有搜索恰用 336 次评估，CMA 指 sep-CMA-ES。人工设计的线性递减 schedule（$\alpha _k = 1.0-0.5k/K$，深度 3 时即 $[1.0, 0.833, 0.667]$）与固定 $\alpha \in \{0.75, 0.5, 0.25\}$ 都不超过 $\alpha {\approx }1$ 基线。$s_0$ 上的消融把策略输入限制到单一特征组；全特征 GA 结果对应 GA 列。}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {等预算的进化式搜索在固定深度上改进隐状态更新。} 相对原始 $\alpha {\approx }1$ 更新的内层子集 EM 增益（pp），随机搜索与三种进化式优化器各用 336 次评估的等预算。$s_0$ 上的特征组消融显示：只有时间索引与只有动力学对都能各自复现全特征增益，而只有熵不能。}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:latent}{{2}{10}{\textbf {等预算的进化式搜索在固定深度上改进隐状态更新。} 相对原始 $\alpha {\approx }1$ 更新的内层子集 EM 增益（pp），随机搜索与三种进化式优化器各用 336 次评估的等预算。$s_0$ 上的特征组消融显示：只有时间索引与只有动力学对都能各自复现全特征增益，而只有熵不能。}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {随深度增长，精炼步对隐状态的改变越来越小。} 冻结 GRU 解码器在固定阻尼下的隐状态轨迹，逐步的位移与方向一致性。后期位移集中于小值，这正是启发我们让步长策略在决策时刻读取熵、位移与方向一致性的动机。}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:traj}{{3}{10}{\textbf {随深度增长，精炼步对隐状态的改变越来越小。} 冻结 GRU 解码器在固定阻尼下的隐状态轨迹，逐步的位移与方向一致性。后期位移集中于小值，这正是启发我们让步长策略在决策时刻读取熵、位移与方向一致性的动机。}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}联合控制与一次性评估（RQ3）}{11}{subsection.4.5}\protected@file@percent }
\newlabel{sec:exp-joint}{{4.5}{11}{联合控制与一次性评估（RQ3）}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {一次性确认区分了保留下来的收益与内层子集上的收益。} 留出折（每种子 $n{=}645$）；非劣效记号见上；置信区间为 $\Delta $EM（pp）相对冻结深度基准的 95\% 组聚类自助区间（20{,}000 次重采样）。J1 在所有种子上非劣效，在 $s_2$ 上仅勉强通过，95\% CI 为 $[-0.50, +7.43]$pp，即 LCB 为 $-0.4975$pp，只高出容限 0.0025pp。由内层适应度选出的最佳联合进化策略在 $s_1$ 与 $s_2$ 上未通过，并在 $s_2$ 上把阈值策略的 EM 增益（配对 $\Delta $EM $-2.02$pp vs.\ J1）全部让出。}}{11}{table.caption.12}\protected@file@percent }
\newlabel{tab:confirm}{{4}{11}{\textbf {一次性确认区分了保留下来的收益与内层子集上的收益。} 留出折（每种子 $n{=}645$）；非劣效记号见上；置信区间为 $\Delta $EM（pp）相对冻结深度基准的 95\% 组聚类自助区间（20{,}000 次重采样）。J1 在所有种子上非劣效，在 $s_2$ 上仅勉强通过，95\% CI 为 $[-0.50, +7.43]$pp，即 LCB 为 $-0.4975$pp，只高出容限 0.0025pp。由内层适应度选出的最佳联合进化策略在 $s_1$ 与 $s_2$ 上未通过，并在 $s_2$ 上把阈值策略的 EM 增益（配对 $\Delta $EM $-2.02$pp vs.\ J1）全部让出。}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {联合策略在哪里输掉。} 留出折（每种子 $n{=}645$）；J1 是阈值策略，J4 是联合调优的策略，$\Delta $EM 以百分点计，相对各种子冻结的最佳固定深度（表~\ref {tab:confirm}）。最后两列把 J4--J1 的差距拆成由被搜索到的停算门控承担的部分与由被搜索到的步长承担的部分，后者通过把 J4 的 $\alpha $ 钉为 1 重新解码得到；翻转计数 J1 与 J4 之间 EM 改变的样本数，写作 修复/破坏。}}{12}{table.caption.13}\protected@file@percent }
\newlabel{tab:decomp}{{5}{12}{\textbf {联合策略在哪里输掉。} 留出折（每种子 $n{=}645$）；J1 是阈值策略，J4 是联合调优的策略，$\Delta $EM 以百分点计，相对各种子冻结的最佳固定深度（表~\ref {tab:confirm}）。最后两列把 J4--J1 的差距拆成由被搜索到的停算门控承担的部分与由被搜索到的步长承担的部分，后者通过把 J4 的 $\alpha $ 钉为 1 重新解码得到；翻转计数 J1 与 J4 之间 EM 改变的样本数，写作 修复/破坏。}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {联合进化收益在一次性确认下消失。} 留出 $\Delta $EM 与 95\% 组聚类自助区间，阈值停算策略（J1）与联合进化策略（J4）在各种子上的对比。虚线标出预注册的 $-0.5$pp 非劣效界；J1 在三个种子上都高于该界，$s_2$ 的区间逼近该界。}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:confirm}{{4}{12}{\textbf {联合进化收益在一次性确认下消失。} 留出 $\Delta $EM 与 95\% 组聚类自助区间，阈值停算策略（J1）与联合进化策略（J4）在各种子上的对比。虚线标出预注册的 $-0.5$pp 非劣效界；J1 在三个种子上都高于该界，$s_2$ 的区间逼近该界。}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}全新划分确认与稳健性检查}{12}{subsection.4.6}\protected@file@percent }
