\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {在未触碰数据上的一次性确认。} 官方 COGS 开发集（$n{=}3{,}000$；组聚类配对自助，20{,}000 次重采样），用冻结的预注册阈值与各种子冻结的最佳固定深度只评估一次。计算量比率与留出折的数值（0.2575 / 0.2570 / 0.5212）到第三位小数一致，因此被执行调用层面的节省本身在划分之间迁移。}}{13}{table.caption.15}\protected@file@percent }
\newlabel{tab:devconfirm}{{6}{13}{\textbf {在未触碰数据上的一次性确认。} 官方 COGS 开发集（$n{=}3{,}000$；组聚类配对自助，20{,}000 次重采样），用冻结的预注册阈值与各种子冻结的最佳固定深度只评估一次。计算量比率与留出折的数值（0.2575 / 0.2570 / 0.5212）到第三位小数一致，因此被执行调用层面的节省本身在划分之间迁移。}{table.caption.15}{}}
