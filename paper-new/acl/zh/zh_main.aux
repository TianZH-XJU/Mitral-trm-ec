\newlabel{sec:method}{{3}{4}{方法}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 递归编码器--解码器架构（依据实际实现绘制）。编码器产生源端记忆与初始解码状态；基步 extsc{GRUCell} 由上一词元嵌入与注意力上下文得到 $z^{(0)}$。所有深度共享同一个精化 extsc{GRUCell} 与同一个输出头，深度增加不引入新参数。}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{4}{递归编码器--解码器架构（依据实际实现绘制）。编码器产生源端记忆与初始解码状态；基步 extsc{GRUCell} 由上一词元嵌入与注意力上下文得到 $z^{(0)}$。所有深度共享同一个精化 extsc{GRUCell} 与同一个输出头，深度增加不引入新参数。}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 某输出位置上的递归精化。基步产生 $z^{(0)}$；共享算子 $F$ 用上一词元嵌入、基步注意力上下文与当前预测的软嵌入 $p^{(k)}E$ 把 $z^{(k)}$ 映射为 $z^{(k+1)}$。共享输出头在每个深度给出分布，参数量不随深度增加。}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:refine}{{2}{4}{某输出位置上的递归精化。基步产生 $z^{(0)}$；共享算子 $F$ 用上一词元嵌入、基步注意力上下文与当前预测的软嵌入 $p^{(k)}E$ 把 $z^{(k)}$ 映射为 $z^{(k+1)}$。共享输出头在每个深度给出分布，参数量不随深度增加。}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 因果词元级停算。每道门控只读取其所控制的精化之前已算出的信号，停下的词元不会使用被跳过的计算。预测的退出深度与实际执行的调用不是同一个量：active-subset 执行器只对继续解码的行运行单元，前向钩子核对拦截到的调用数与 $N_{\mathrm  {cell}}$ 一致。}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:halt}{{3}{5}{因果词元级停算。每道门控只读取其所控制的精化之前已算出的信号，停下的词元不会使用被跳过的计算。预测的退出深度与实际执行的调用不是同一个量：active-subset 执行器只对继续解码的行运行单元，前向钩子核对拦截到的调用数与 $N_{\mathrm {cell}}$ 一致。}{figure.caption.3}{}}
