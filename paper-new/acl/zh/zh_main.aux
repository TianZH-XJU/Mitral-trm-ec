\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {置信停算以一小部分执行计算量保持住精确匹配准确率。} 留出折（每种子 $n{=}645$），相对各种子冻结的最佳固定深度（种子 0--1 为 $e_3$，种子 2 为 $e_1$）。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp 判定，\emph  {而非}点估计；CMA-ES 指 sep-CMA-ES。阈值策略在三个种子上都非劣效；9 个进化式策略中只有 2 个通过，尽管 7 个满足点估计容差。}}{9}{table.caption.6}\protected@file@percent }
\newlabel{tab:halting}{{3}{9}{\textbf {置信停算以一小部分执行计算量保持住精确匹配准确率。} 留出折（每种子 $n{=}645$），相对各种子冻结的最佳固定深度（种子 0--1 为 $e_3$，种子 2 为 $e_1$）。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp 判定，\emph {而非}点估计；CMA-ES 指 sep-CMA-ES。阈值策略在三个种子上都非劣效；9 个进化式策略中只有 2 个通过，尽管 7 个满足点估计容差。}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 三个 GRU 种子上阈值策略与等预算搜索策略的准确率差与执行调用比。}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:frontier}{{4}{9}{三个 GRU 种子上阈值策略与等预算搜索策略的准确率差与执行调用比。}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces active-subset 执行器的停算与强制 $e_3$ 中位墙钟时间比。}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:wall}{{5}{10}{active-subset 执行器的停算与强制 $e_3$ 中位墙钟时间比。}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {阈值本身已经位于准确率--计算量前沿上。} 每个种子都把预注册阈值与等预算优化器找到的最省策略相对照。被搜索到的策略比阈值最多再多省 2.1\%，而且在种子 0--1 上它们通不过阈值通得过的非劣效界。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp 判定；额外节省指被搜索到的策略相对阈值自身节省额多去掉的那部分计算量。完整策略列表见表~\ref {tab:halting}。}}{10}{table.caption.8}\protected@file@percent }
\newlabel{tab:frontier}{{4}{10}{\textbf {阈值本身已经位于准确率--计算量前沿上。} 每个种子都把预注册阈值与等预算优化器找到的最省策略相对照。被搜索到的策略比阈值最多再多省 2.1\%，而且在种子 0--1 上它们通不过阈值通得过的非劣效界。非劣效由预注册规则 LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp 判定；额外节省指被搜索到的策略相对阈值自身节省额多去掉的那部分计算量。完整策略列表见表~\ref {tab:halting}。}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 四个架构的六项潜状态动力学指标随深度的变化，阴影为种子范围。}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:latcross}{{5}{11}{四个架构的六项潜状态动力学指标随深度的变化，阴影为种子范围。}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces 四项潜状态指标的种子均值（3 个种子，256 样本）。范数为 $\lVert z_k\rVert /\sqrt  d$；完整逐深度区间见公开结果表。}}{11}{table.caption.11}\protected@file@percent }
\newlabel{tab:latstat}{{6}{11}{四项潜状态指标的种子均值（3 个种子，256 样本）。范数为 $\lVert z_k\rVert /\sqrt d$；完整逐深度区间见公开结果表。}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces 45 次搜索汇总；相对 $\alpha \!\equiv \!1$ 基线的增益（pp），192 样本内层子集。}}{12}{table.caption.12}\protected@file@percent }
\newlabel{tab:optagg}{{7}{12}{45 次搜索汇总；相对 $\alpha \!\equiv \!1$ 基线的增益（pp），192 样本内层子集。}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 每次搜索相对自身基线的最佳至当前增益（每种算法九次运行的均值）。}}{12}{figure.caption.13}\protected@file@percent }
\newlabel{fig:optcurves}{{6}{12}{每次搜索相对自身基线的最佳至当前增益（每种算法九次运行的均值）。}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {步长策略在计算量恒定时提高固定深度的精确匹配准确率。} 相对原始 $\alpha {\approx }1$ 更新、在内层子集（$n{=}192$）上的固定深度（$N_{\mathrm  {cell}}$ 恒定）改进；所有搜索恰用 336 次评估，CMA 指 sep-CMA-ES。人工设计的线性递减 schedule（$\alpha _k = 1.0-0.5k/K$，深度 3 时即 $[1.0, 0.833, 0.667]$）与固定 $\alpha \in \{0.75, 0.5, 0.25\}$ 都不超过 $\alpha {\approx }1$ 基线。$s_0$ 上的消融把策略输入限制到单一特征组；全特征 GA 结果对应 GA 列。}}{12}{table.caption.14}\protected@file@percent }
\newlabel{tab:latent}{{8}{12}{\textbf {步长策略在计算量恒定时提高固定深度的精确匹配准确率。} 相对原始 $\alpha {\approx }1$ 更新、在内层子集（$n{=}192$）上的固定深度（$N_{\mathrm {cell}}$ 恒定）改进；所有搜索恰用 336 次评估，CMA 指 sep-CMA-ES。人工设计的线性递减 schedule（$\alpha _k = 1.0-0.5k/K$，深度 3 时即 $[1.0, 0.833, 0.667]$）与固定 $\alpha \in \{0.75, 0.5, 0.25\}$ 都不超过 $\alpha {\approx }1$ 基线。$s_0$ 上的消融把策略输入限制到单一特征组；全特征 GA 结果对应 GA 列。}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 冻结的 GRU-s0 步长策略：各种子相对强制 $e_3$ 的 EM 差（pp）。}}{13}{table.caption.15}\protected@file@percent }
\newlabel{tab:trans}{{9}{13}{冻结的 GRU-s0 步长策略：各种子相对强制 $e_3$ 的 EM 差（pp）。}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {一次性确认区分了保留下来的收益与内层子集上的收益。} 留出折（每种子 $n{=}645$）；非劣效记号见上；置信区间为 $\Delta $EM（pp）相对冻结深度基准的 95\% 组聚类自助区间（20{,}000 次重采样）。J1 在所有种子上非劣效，在 $s_2$ 上仅勉强通过，95\% CI 为 $[-0.50, +7.43]$pp，即 LCB 为 $-0.4975$pp，只高出容限 0.0025pp。由内层适应度选出的最佳联合进化策略在 $s_1$ 与 $s_2$ 上未通过，并在 $s_2$ 上把阈值策略的 EM 增益（配对 $\Delta $EM $-2.02$pp vs.\ J1）全部让出。}}{13}{table.caption.16}\protected@file@percent }
\newlabel{tab:confirm}{{10}{13}{\textbf {一次性确认区分了保留下来的收益与内层子集上的收益。} 留出折（每种子 $n{=}645$）；非劣效记号见上；置信区间为 $\Delta $EM（pp）相对冻结深度基准的 95\% 组聚类自助区间（20{,}000 次重采样）。J1 在所有种子上非劣效，在 $s_2$ 上仅勉强通过，95\% CI 为 $[-0.50, +7.43]$pp，即 LCB 为 $-0.4975$pp，只高出容限 0.0025pp。由内层适应度选出的最佳联合进化策略在 $s_1$ 与 $s_2$ 上未通过，并在 $s_2$ 上把阈值策略的 EM 增益（配对 $\Delta $EM $-2.02$pp vs.\ J1）全部让出。}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces \textbf  {在未触碰数据上的一次性确认。} 官方 COGS 开发集（$n{=}3{,}000$；组聚类配对自助，20{,}000 次重采样），用冻结的预注册阈值与各种子冻结的最佳固定深度只评估一次。计算量比率与留出折的数值（0.2575 / 0.2570 / 0.5212）在种子0--1上到第三位小数一致，种子2相差0.003（相对0.6\%），因此被执行调用层面的节省本身在划分之间以不足百分之一的幅度迁移。}}{14}{table.caption.17}\protected@file@percent }
\newlabel{tab:devconfirm}{{11}{14}{\textbf {在未触碰数据上的一次性确认。} 官方 COGS 开发集（$n{=}3{,}000$；组聚类配对自助，20{,}000 次重采样），用冻结的预注册阈值与各种子冻结的最佳固定深度只评估一次。计算量比率与留出折的数值（0.2575 / 0.2570 / 0.5212）在种子0--1上到第三位小数一致，种子2相差0.003（相对0.6\%），因此被执行调用层面的节省本身在划分之间以不足百分之一的幅度迁移。}{table.caption.17}{}}
