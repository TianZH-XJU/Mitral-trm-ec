\@writefile{toc}{\contentsline {section}{\numberline {3}方法}{4}{section.3}\protected@file@percent }
\newlabel{sec:method}{{3}{4}{方法}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {TRACER：一个框架，三条研究主线。} \textbf  {(a)} 冻结的递归模型产生 $e_0$ 至 $e_3$ 四个深度。两道因果门控只读取其所控制的精化之前已可得的置信度，因此停下的词元不会进入被跳过的调用；前向钩子核对真实执行调用数 $N_{\mathrm  {cell}}$。\textbf  {(b)} 同一批检查点给出自由运行的潜状态轨迹，归纳为六项模型内摘要及自助区间，区分有界门控态与无界累积态。\textbf  {(c)} 在固定深度下，五参数步长策略缩放每次精化；策略先被冻结，再做一次性外层确认与跨架构迁移测试。三个面板共享同一执行调用定义与非劣效判据，每个面板最右侧标出相应结论的成立条件或边界。}}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:method_overview}{{1}{5}{\textbf {TRACER：一个框架，三条研究主线。} \textbf {(a)} 冻结的递归模型产生 $e_0$ 至 $e_3$ 四个深度。两道因果门控只读取其所控制的精化之前已可得的置信度，因此停下的词元不会进入被跳过的调用；前向钩子核对真实执行调用数 $N_{\mathrm {cell}}$。\textbf {(b)} 同一批检查点给出自由运行的潜状态轨迹，归纳为六项模型内摘要及自助区间，区分有界门控态与无界累积态。\textbf {(c)} 在固定深度下，五参数步长策略缩放每次精化；策略先被冻结，再做一次性外层确认与跨架构迁移测试。三个面板共享同一执行调用定义与非劣效判据，每个面板最右侧标出相应结论的成立条件或边界。}{figure.caption.1}{}}
