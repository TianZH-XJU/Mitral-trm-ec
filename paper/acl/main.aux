\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Confidence halting retains exact-match accuracy at a fraction of the executed compute. Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). Non-inferiority is decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm  {EM}) \geq -0.5$pp, \emph  {not} by point estimates. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 7 of 9 satisfy the point-estimate margin.}}{4}{table.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:halting}{{1}{4}{Confidence halting retains exact-match accuracy at a fraction of the executed compute. Held-out fold ($n{=}645$ per seed), relative to each seed's frozen best fixed depth ($e_3$ for seeds 0--1, $e_1$ for seed 2). Non-inferiority is decided by the preregistered rule LCB$_{95\%}(\Delta \mathrm {EM}) \geq -0.5$pp, \emph {not} by point estimates. The threshold policy is non-inferior on all three seeds; only 2 of 9 evolutionary policies pass, although 7 of 9 satisfy the point-estimate margin}{table.caption.6}{}}
