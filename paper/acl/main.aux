\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Joint Control and One-Shot Evaluation (RQ3)}{6}{subsection.4.5}\protected@file@percent }
\newlabel{sec:exp-joint}{{4.5}{6}{Joint Control and One-Shot Evaluation (RQ3)}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces One-shot confirmation separates retained gains from inner-subset gains. Held-out fold ($n{=}645$ per seed); CIs are 95\% group-cluster bootstrap intervals of $\Delta $EM (pp) vs.\ the frozen-depth baseline (20{,}000 resamples). J1 passes non-inferiority on all seeds, on $s_2$ only marginally, with 95\% CI $[-0.50, +7.43]$pp, i.e., an LCB of $-0.4975$pp, only 0.0025pp above the bound. The best joint EC policy (selected by inner fitness) fails on $s_1$ and $s_2$, losing on $s_2$ the entire EM gain of the threshold policy (paired $\Delta $EM $-2.02$pp vs.\ J1).}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:confirm}{{3}{6}{One-shot confirmation separates retained gains from inner-subset gains. Held-out fold ($n{=}645$ per seed); CIs are 95\% group-cluster bootstrap intervals of $\Delta $EM (pp) vs.\ the frozen-depth baseline (20{,}000 resamples). J1 passes non-inferiority on all seeds, on $s_2$ only marginally, with 95\% CI $[-0.50, +7.43]$pp, i.e., an LCB of $-0.4975$pp, only 0.0025pp above the bound. The best joint EC policy (selected by inner fitness) fails on $s_1$ and $s_2$, losing on $s_2$ the entire EM gain of the threshold policy (paired $\Delta $EM $-2.02$pp vs.\ J1)}{table.caption.11}{}}
